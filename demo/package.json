{
  "name": "react-native-webrtc-kaleidoscope-demo",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:wsl": "REACT_NATIVE_PACKAGER_HOSTNAME=\"$(powershell.exe -NoProfile -Command '$nic = Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway -ne $null -and $_.NetAdapter.Status -eq \"Up\" -and $_.NetAdapter.HardwareInterface -eq $true -and $_.NetAdapter.InterfaceDescription -notmatch \"Hyper-V|WSL|Virtual|vEthernet|TAP|Loopback\" } | Select-Object -First 1; $nic.IPv4Address.IPAddress' | tr -d '\\r')\" METRO_LISTEN_ADDRESS=0.0.0.0 EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 bunx expo start --dev-client --host lan --port 8081 --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "expo export -p web",
    "check:expo": "npx expo install --check && npx expo-doctor --verbose"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "4.5.5",
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "~0.13.3",
    "expo-constants": "~17.0.8",
    "expo-dev-client": "~5.0.20",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.22",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "nativewind": "4.1.x",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-css-interop": "^0.1.22",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "^0.19.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webrtc-kaleidoscope": "file:..",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "expo-doctor": "1.18.19",
    "typescript": "~5.3.3"
  },
  "overrides": {
    "react-native": "0.76.9",
    "@babel/core": "7.29.6",
    "@remix-run/server-runtime": "2.17.5",
    "ajv": "8.20.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "fast-uri": "3.1.4",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "postcss": "8.5.26",
    "send": "0.19.2",
    "shell-quote": "1.9.0",
    "undici": "6.27.0"
  }
}
