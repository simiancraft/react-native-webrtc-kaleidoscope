{
  "name": "react-native-webrtc-kaleidoscope-demo",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:wsl": "REACT_NATIVE_PACKAGER_HOSTNAME=\"$(powershell.exe -NoProfile -Command '$nic = Get-NetIPConfiguration | Where-Object { $_.IPv4DefaultGateway -ne $null -and $_.NetAdapter.Status -eq \"Up\" -and $_.NetAdapter.HardwareInterface -eq $true -and $_.NetAdapter.InterfaceDescription -notmatch \"Hyper-V|WSL|Virtual|vEthernet|TAP|Loopback\" } | Select-Object -First 1; $nic.IPv4Address.IPAddress' | tr -d '\\r')\" METRO_LISTEN_ADDRESS=0.0.0.0 EXPO_DEVTOOLS_LISTEN_ADDRESS=0.0.0.0 bunx expo start --dev-client --host lan --port 8081 --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "build": "expo export -p web",
    "check:expo": "npx expo install --check && npx expo-doctor --verbose"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.37",
    "expo-asset": "~12.0.13",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "nativewind": "4.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-webrtc": "^124.0.7",
    "react-native-webrtc-kaleidoscope": "file:..",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "expo-doctor": "1.18.19",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native": "0.81.5",
    "@babel/core": "7.29.6",
    "@remix-run/server-runtime": "2.17.5",
    "ajv": "8.20.0",
    "brace-expansion@1": "1.1.16",
    "brace-expansion@2": "2.1.2",
    "fast-uri": "3.1.4",
    "js-yaml@3": "3.15.0",
    "js-yaml@4": "4.3.0",
    "postcss": "8.5.26",
    "send": "0.19.2",
    "shell-quote": "1.9.0",
    "undici": "6.27.0"
  }
}
